{
  "name": "nikki-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ocr-assets.mjs",
    "dev": "vite --port 8080",
    "prebuild": "node scripts/ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8080",
    "test": "TZ=Europe/Lisbon vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "VITE_DEMO=1 vite build --outDir dist-demo && node scripts/demo-html.mjs dist-demo nikki-demo.html"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/por": "1.0.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "3.11.0",
    "typescript": "5.8.3",
    "vite": "5.4.19",
    "vitest": "3.2.7"
  }
}
